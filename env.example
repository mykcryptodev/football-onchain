# App Configuration
# Canonical domain is bankrball.com; superbowlsquares.app is also attached in
# Vercel and resolves to the same deployment.
NEXT_PUBLIC_APP_URL=https://bankrball.com  # Or http://localhost:3000 for local dev

# Thirdweb
THIRDWEB_SECRET_KEY=
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Neynar API (for Farcaster bio fetching)
NEYNAR_API_KEY=

# OpenSea API (for marketplace integration)
OPENSEA_API_KEY=

# Neon Database
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vercel Blob (pre-generated Pick'em entry share images)
# Create/link a Blob store in the Vercel dashboard (Storage → Blob) for this
# project; Vercel then injects this automatically in every environment. Only
# needed locally if you want to exercise the render pipeline outside Vercel.
BLOB_READ_WRITE_TOKEN=
# Days a rendered entry image (and its Redis status record) is kept before the
# /api/cron/pickem-images sweep deletes it. Defaults to 30 if unset.
PICKEM_IMAGE_RETENTION_DAYS=30

# Self-hosted oracle writer (api/oracle/*)
# Hot wallet authorized via setReporter() on the oracle contract — scores only, no funds access
ORACLE_REPORTER_PRIVATE_KEY=
# Bearer secret for Vercel crons (/api/oracle/sync, /api/cron/pickem-images)
CRON_SECRET=
# Webhook secret shown by thirdweb after creating the Insight webhook
# (Project → Tokens → Webhooks); deliveries are HMAC-SHA256 signed (x-webhook-signature)
ORACLE_WEBHOOK_SECRET=
# Discord webhook for error alerts (errors only, silent on success)
ORACLE_DISCORD_WEBHOOK_URL=
# Optional RPC override (defaults to viem's public Base RPC)
# Optional RPC override for the oracle writer AND the Bankr pickem skill's
# reads (src/lib/bankr/service.ts). Defaults to the thirdweb RPC keyed by
# NEXT_PUBLIC_THIRDWEB_CLIENT_ID (https://8453.rpc.thirdweb.com/<id>). A
# Coinbase Developer Platform Base RPC endpoint
# (https://api.developer.coinbase.com/rpc/v1/base/<your-key>) also works here
# — get your own key from the CDP dashboard; never commit the URL with a key
# in it, only set it as a deployment env var.
ORACLE_RPC_URL=
# Optional ceiling on network gas price (gwei) the oracle writer will pay.
# Unset = no cap. If the network's current maxFeePerGas exceeds this, the
# write throws instead of submitting (caught by the sync/webhook error paths
# and alerted via ORACLE_DISCORD_WEBHOOK_URL).
ORACLE_MAX_GAS_PRICE_GWEI=

# Weekly slate automation behavior:
#
# - On every /api/oracle/sync cron run, the oracle writer fetches ESPN's current
#   NFL week slate and compares it with what is stored onchain.
# - Writes a type-2 weekGames report only when the slate is absent or differs
#   (games postponed, rescheduled, or replaced).
# - This ensures users can create Pick'em contests without first calling
#   fetchWeekGames themselves.
# - Existing contests remain immutable; if a game postponement creates a
#   conflict after contest creation (ESPN slate differs from oracle's stored
#   snapshot), create a replacement contest before picks lock and direct users
#   to the new one.
# - The cron runs idempotently: reordered matches skip gas, only actual
#   changes trigger a transaction.
